# Copie para .env.local e ajuste. .env.local não vai para o git.

# Fonte dos eventos: "true" = src/mocks/events.json, "false" = Google Calendar API.
# Sem valor, o app usa o mock.
VITE_USE_MOCK=true

# Chave da Google Calendar API (obrigatória quando VITE_USE_MOCK=false).
# Crie no Google Cloud, restrita por HTTP referrer.
VITE_GOOGLE_API_KEY=

# Só para o mock: atraso artificial em ms, para ver skeletons. Ex.: 1500.
VITE_MOCK_DELAY_MS=

# Link "Teste" no menu para a área de teste (/teste: ferramentas internas como /teste/precos). As
# páginas existem no site publicado para quem tem o link; só o link no menu depende disto.
# Só local: deixe vazio no deploy.
VITE_TEST_PAGES=

# Analytics (GoatCounter, sem cookies). Código do site em https://<codigo>.goatcounter.com; vazio = desligado.
VITE_GOATCOUNTER_CODE=
